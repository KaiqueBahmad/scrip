# Copy to .env and adjust. Read automatically by `docker compose`.

# Host-side ports published by docker-compose.yml / docker-compose.prod.yml.
# Container-internal ports stay fixed (nginx on 8080, API on 8081) — only what you
# access from the host changes.
FRONTEND_PORT=8080
BACKEND_PORT=8081

# Public URL of the backend, as reached from the browser. Written into the frontend's
# runtime config at container startup — no rebuild needed, even against the prebuilt
# Docker Hub image. Keep this in sync with BACKEND_PORT above.
API_BASE_URL=http://localhost:8081
