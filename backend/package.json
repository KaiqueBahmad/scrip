{
  "name": "pseudopay",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway de pagamento PIX simulado, self-hosted, para desenvolvimento e testes de integração",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch --require ts-node/register/transpile-only src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --require ts-node/register/transpile-only --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.3",
    "jsonwebtoken": "^9.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
