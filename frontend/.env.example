# Copy to .env and adjust. Only VITE_* vars reach the browser bundle.

# Base URL the browser prefixes to every API call. Leave empty to keep requests
# relative (/v1/...), which is what the dev proxy below expects.
VITE_API_BASE_URL=

# Where `npm run dev` proxies /v1 to. Read by vite.config.ts at startup only.
PSEUDOPAY_API=http://127.0.0.1:4242

# Port the dev server listens on.
VITE_DEV_PORT=5273
