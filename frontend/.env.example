# Copy to .env and adjust. Only VITE_* vars reach the browser bundle.

# Origin of the Scrip API. The browser calls it directly — there is no dev proxy —
# so the API must allow this app's origin via CORS.
VITE_API_BASE_URL=http://127.0.0.1:4242

# Port the dev server listens on.
VITE_DEV_PORT=5273
