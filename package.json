{
  "name": "pseudopay",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway de pagamento PIX simulado, self-hosted, para desenvolvimento e testes de integração",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "npm run build:server && npm run build:admin",
    "build:server": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:admin": "npm --prefix admin run build",
    "reset": "tsx src/db/reset.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.3.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
